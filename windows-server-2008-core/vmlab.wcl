// Windows Server 2008 Server Core template (PRD §6.1). Legacy guest: SeaBIOS +
// IDE + e1000 (the windows-legacy profile), installed from the same local
// MSDN/VL ISO as windows-server-2008 — the answer file just selects image
// index 2, the Server Core image, instead of the full/GUI one.
//
// autounattend.xml installs Windows and then, on first logon, runs the vmlab
// bootstrap ISO's install.cmd and `sysprep /generalize /oobe /shutdown` — in
// that order, because the build's verification boot waits for the agent's
// handshake and an image sealed without one fails. Clones come up generalized
// and agent-carrying, which matters more here than anywhere: on Core the agent
// is how a host drives the machine at all.

import <vmlab.wcl>

template "windows-server-2008-core" {
  arch    = "x86_64"
  version = "6001.0"
  profile = "windows-legacy"
  cpus    = 2
  memory  = 4GiB
  disk    = 40GiB

  source "iso" { path = "../iso/en_windows_server_2008_x64_dvd_x14-26714.iso" }

  // An ISO, not a floppy: the answer file now travels with the vioserial
  // driver, and 1.5MB of driver does not fit on 1.44MB of floppy. The
  // guest has four IDE slots — disk, install DVD, this, and the agent
  // bootstrap ISO — which is exactly four.
  media { kind = "iso" from = "./unattend/" label = "UNATTEND" }
  nic { nat = true }

  provision "scripts/install.ws" { }
}
