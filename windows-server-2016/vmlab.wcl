// Windows Server 2016 template (PRD §6.1). Legacy guest: SeaBIOS + IDE +
// e1000 (the windows-legacy profile), installed from a local MSDN/VL ISO in
// ../iso/. It installs keyless (no product key needed), so no .env entry.
//
// autounattend.xml installs Windows and then, on first logon, runs the vmlab
// bootstrap ISO's install.cmd and `sysprep /generalize /oobe /shutdown` — in
// that order, because the build's verification boot waits for the agent's
// handshake and an image sealed without one fails. The build waits for the VM
// to power off and seals the generalized disk, so clones come up generalized
// AND agent-carrying: `ready`, `exec` and `cp` all work.

import <vmlab.wcl>

template "windows-server-2016" {
  arch    = "x86_64"
  version = "14393.0"
  profile = "windows-legacy"
  cpus    = 2
  memory  = 4GiB
  disk    = 40GiB

  source "iso" { path = "../iso/en_windows_server_2016_x64_dvd_9327751.iso" }

  media { kind = "floppy" from = "./unattend/" label = "UNATTEND" }
  nic { nat = true }

  provision "scripts/install.ws" { }
}
