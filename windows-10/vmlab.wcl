// Windows 10 Enterprise (Evaluation) template (PRD §6.1). Fully unattended:
// unattend/ is packed into an ISO carrying autounattend.xml, the virtio
// storage/net drivers Windows Setup needs (the windows-10 profile uses
// virtio disk + NIC), and the guest tooling MSIs installed on first logon.
//
//   ./fetch-deps.sh        # one-time: pull virtio drivers + MSIs into unattend/
//   vmlab template build   # ~30-45 minutes
//
// Windows 10 needs no TPM/secure boot, so the windows-10 profile leaves
// both off. The eval ISO is licensed for 90 days — see README.md.

import <vmlab.wcl>

template "windows-10" {
  arch    = "x86_64"
  version = "19045.2006"
  registry = "ghcr.io/vmlabdev/vmlab-templates/windows-10"
  profile = "windows-10"
  cpus    = 4
  memory  = 8GiB
  disk    = 60GiB

  source "iso" {
    url    = "https://software-static.download.prss.microsoft.com/dbazure/988969d5-f34g-4e03-ac9d-1f9786c66750/19045.2006.220908-0225.22h2_release_svc_refresh_CLIENTENTERPRISEEVAL_OEMRET_x64FRE_en-us.iso"
    sha256 = "ef7312733a9f5d7d51cfa04ac497671995674ca5e1058d5164d6028f0938d668"
  }

  media { kind = "iso" from = "./unattend/" label = "UNATTEND" }
  nic { nat = true }

  // Builds the base: installed, patched and NOT generalized (PRD §6.6). The
  // base is never cloned by a lab; a bare `x86_64/windows-10` means the default
  // variant below.
  provision "scripts/install.ws" { }

  // The sealed image labs clone: the base, generalized.
  variant "standard" {
    default     = true
    description = "Generalized with sysprep: a fresh SID and computer name per clone"
    // Runs on every clone's first boot, before the VM is reported ready: waits
    // for sysprep specialize/OOBE to finish (the specialize-pass marker), then
    // clears it. So labs using this template never see a half-specialized clone.
    first_boot = "scripts/firstboot.ws"
    provision "scripts/generalize.ws" { }
  }

  // `standard` plus the vmlab-win3d driver package (virtio-gpu 3D on a Venus
  // host: D3D9-12, OpenGL and Vulkan in the guest), installed on the base and
  // then generalized with it. fetch-deps.sh stages the pinned release into
  // win3d/, which rides the build as the WIN3D ISO (the gitignored payload).
  variant "win3d" {
    description = "Standard plus the vmlab-win3d 3D driver package (test-signed; clones need gpu { mode = \"vulkan\" })"
    // The package is test-signed: the build boot turns test signing on, and
    // every clone boots without Secure Boot too, or Windows ignores it.
    secure_boot = false
    // The build VM needs a virtio-gpu device with VIRGL and blob resources,
    // or the KMD never starts and the installer's verify fails. vmlab
    // 0.30.0-alpha accepts no `gpu {}` on a variant, so the device is named
    // directly (vmlab passes an unknown `display` to QEMU as written) and
    // the GL display comes through `qemu_args`: the same device line vmlab
    // emits for `gpu { mode = "vulkan" }`, minus the host GPU choice. It
    // renders on QEMU's default render node and the host's default Vulkan
    // driver, so the build needs a Venus-capable host (README). A clone of
    // this variant inherits the display, so it must declare `gpu { mode =
    // "vulkan" }` (or "virgl"): without one, QEMU has no GL display for it.
    display   = "virtio-vga-gl,venus=true,blob=true,hostmem=4G"
    qemu_args = ["-display", "egl-headless"]
    first_boot = "scripts/firstboot.ws"
    media { kind = "iso" from = "./win3d/" label = "WIN3D" }
    provision "scripts/win3d-setup.ws" { }
    provision "scripts/generalize.ws" { }
  }
}
