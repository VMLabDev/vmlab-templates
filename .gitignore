# Downloaded build payloads — fetched on demand, never committed.
*.iso
*.ISO
*.qcow2
*.img
*.msi
*.tar.zst
*.7z
*.zip

# staged by each template's fetch-deps.sh
windows-server-2025/unattend/drivers/
windows-server-2025-core/unattend/drivers/
windows-server-2022-core/unattend/drivers/
windows-server-2019-core/unattend/drivers/
windows-7-x86/unattend/drivers/
windows-7/unattend/drivers/
windows-8-x86/unattend/drivers/
windows-8.1-x86/unattend/drivers/
windows-8/unattend/drivers/
windows-8.1/unattend/drivers/
windows-server-2008-r2/unattend/drivers/
windows-server-2008-r2-core/unattend/drivers/
windows-server-2012/unattend/drivers/
windows-server-2012-core/unattend/drivers/
windows-server-2012-r2/unattend/drivers/
windows-server-2012-r2-core/unattend/drivers/
windows-server-2016/unattend/drivers/
windows-server-2016-core/unattend/drivers/
kali/disk/
parrot/disk/
windows-10/win3d/
windows-11/win3d/

# Hand-supplied installer media for the MSDN/VL templates (iso/README.md says
# which); only the README is tracked.
/iso/*
!/iso/README.md

# Product keys for the MSDN/VL ISOs in iso/ — never commit real keys
.env

# Lab-local working data (clones, state, media) created when running an example
.vmlab/

# Generated docs site
/docs/_site
home-assistant-aarch64/haos_generic-aarch64-*.qcow2

# Browser-automation scratch (playwright-cli snapshots/logs)
.playwright-cli/

# Session scratch: evidence, isolated stores, throwaway labs
.scratch/
