// Ubuntu Server 26.04 LTS template (PRD §6.1), built from the official
// cloud image + cloud-init (simpler than the 24.04 subiquity ISO install).
// The qcow2 is downloaded and sha256-verified into the artefact cache;
// cloudinit/ is packed into a CIDATA ISO (NoCloud datasource) that creates
// the vmlab login and installs the vmlab guest agent on first boot.
//
//   vmlab template build        (run from this directory)
//
// Image pinned to release-20261108; sha256 from that directory's SHA256SUMS,
// verified with the Ubuntu cloud image signing key
// D2EB44626FDDC30B513D5BB71A5D6C4C7DB87C81.

import <vmlab.wcl>

template "ubuntu-26.04" {
  arch     = "x86_64"
  version  = "26.04"
  registry = "ghcr.io/vmlabdev/vmlab-templates/ubuntu-26.04"
  profile  = "linux-modern"
  firmware = "seabios"
  cpus     = 2
  memory   = 4GiB
  disk     = 20GiB

  source "qcow2" {
    url    = "https://cloud-images.ubuntu.com/releases/26.04/release-20261108/ubuntu-26.04-server-cloudimg-amd64.img"
    sha256 = "7b90593f5532b49b7e3fe3d2743f0d1f0d822e5b07cebcd8e00c0df8069ecab9"
  }

  media { kind = "iso" from = "./cloudinit/" label = "CIDATA" }
  nic { nat = true }

  // Each clone gets its own login password on first boot (README.md).
  first_boot = "scripts/firstboot.ws"

  provision "scripts/install.ws" { }
}
