// windows-98 template (PRD §6.1). Windows 98 (first edition) on the
// windows-9x profile (i440fx/SeaBIOS/IDE, Cirrus VGA, AMD PCnet NIC).
//
// The bootable CD's own Setup partitions and formats the blank disk; the build
// provision then quits to a prompt and runs B:\VMLAB.BAT, which copies the
// CD's install folder (patched for modern CPUs by fetch-deps.sh) from the
// VMLABSRC CD to C: and runs Setup there with B:\MSBATCH.INF (key injected
// from .env). MSBATCH.INF registers C:\VMLAB\BOOT.BAT under RunServices; it
// installs vmlab's legacy agent from the VMLAB bootstrap ISO: exec only, on
// COM1 (agent_transport = "isa-serial"), answering before anyone logs on.

import <vmlab.wcl>

template "windows-98" {
  arch    = "x86"
  version = "4.10.1998"
  profile = "windows-9x"
  // Windows 9x crashes in Setup and Explorer on a modern host CPU's CPUID;
  // a period model keeps it on what it was written for. Clones inherit it.
  cpu_model = "pentium3"
  cpus    = 1
  memory  = 128MiB
  disk    = 2GiB

  source "iso" { path = "../iso/win98_fe_en.iso" }
  // Read as B:\ — the CD's El Torito boot floppy takes A:.
  media { kind = "floppy" from = "./answer/" label = "MSBATCH" }
  // The CD's install folder, patched by fetch-deps.sh for modern CPUs
  // (patcher9x); the build copies it to C: and runs Setup from there.
  media { kind = "iso" from = "./src/" label = "VMLABSRC" }
  provision "scripts/install.ws" { }
}
