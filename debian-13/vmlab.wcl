// Debian 13 (trixie) template built from the official genericcloud qcow2.
// cloud-init picks up the CIDATA ISO (NoCloud), creates vmlab/vmlab,
// installs the vmlab guest agent (VMLAB bootstrap ISO) and the provision script confirms the
// agent answers before the image is sealed. Build with:
//
//   vmlab template build        (run from this directory)
//
// Image pinned to cloud build 20261001-2618; sha512-verified against
// cloud.debian.org SHA512SUMS, sha256 computed from the verified file.

import <vmlab.wcl>

template "debian-13" {
  arch    = "x86_64"
  version = "13.20261001"
  registry = "ghcr.io/vmlabdev/vmlab-templates/debian-13"
  profile = "linux-modern"
  cpus    = 2
  memory  = 2GiB
  disk    = 20GiB

  source "qcow2" {
    url    = "https://cloud.debian.org/images/cloud/trixie/20261001-2618/debian-13-genericcloud-amd64-20261001-2618.qcow2"
    sha256 = "b2aca2bee42c7082fd6aba4a5bb1a89612087a405e99896920f3346f7b23b9d1"
  }

  media { kind = "iso" from = "./cloudinit/" label = "CIDATA" }
  nic { nat = true }

  provision "scripts/install.ws" { }
}
