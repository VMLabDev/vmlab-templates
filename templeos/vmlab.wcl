// TempleOS template (PRD §6.1). Terry A. Davis's public-domain 64-bit hobby
// OS (templeos.org), booted from the official ISO and auto-installed onto a
// blank RedSea disk.
//
// TempleOS is public domain, so — unlike the proprietary/MS vintage entries —
// it is freely redistributable and carries a `registry`. The ISO is downloaded
// and sha256-verified into the artefact cache; no fetch-deps step.
//
// It carries the HolyC build of the vmlab guest agent (PRD §7.4, the legacy
// tier): exec only, over a 16550 on COM1. TempleOS reads no ISO 9660 and has
// no network, so the agent is typed at the shell after the install (about
// eight minutes of keystrokes), lands in C:/Home and starts from
// ~/MakeHome.HC.Z at every boot. Clones report `ready` and take
// `vmlab exec <vm> -- '<HolyC>'`; there is no `cp` or `shell`. The build also
// makes the installed boot loader pick Drive C on its own, so a clone boots
// unattended. The CD's `#include "Once"` installer is driven over the live
// screen (image matching — TempleOS's bitmap font defeats OCR); see
// scripts/install.ws.
//
// The shipped templeos profile fits it: i440fx + SeaBIOS (TempleOS wants a
// legacy-BIOS MBR boot), an IDE/ATA disk (its only disk driver), plain std VGA
// (it drives VBE directly), QMP keyboard input (over VNC, TempleOS sees each
// shift a keystroke late) and the COM1 agent channel. The e1000 NIC the
// profile adds is unused.

import <vmlab.wcl>

template "templeos" {
  arch     = "x86_64"
  version  = "5.03"
  registry = "ghcr.io/vmlabdev/vmlab-templates/templeos"
  profile  = "templeos"
  cpus     = 2
  memory   = 512MiB
  disk     = 2GiB

  source "iso" {
    url    = "https://templeos.org/Downloads/TempleOS.ISO"
    sha256 = "5d0fc944e5d89c155c0fc17c148646715bc1db6fa5750c0b913772cfec19ba26"
  }

  provision "scripts/install.ws" { }
}
