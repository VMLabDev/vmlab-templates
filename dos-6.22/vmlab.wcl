// dos-6.22 template (PRD §6.1). Pre-autounattend.xml era guest on the windows-9x
// profile (i440fx/SeaBIOS/IDE, Cirrus VGA, AMD PCnet NIC). The installer is
// driven by the build provision wscript via screenshots + keyboard/mouse, since
// these OSes have no answer-file auto-load and no QEMU guest agent.

import <vmlab.wcl>

template "dos-6.22" {
  arch    = "x86"
  version = "6.22"
  profile = "windows-9x"
  cpus    = 1
  memory  = 32MiB
  disk    = 1GiB

  // No 32-bit vmlab-agent exists — guest/build-agent.sh builds no x86
  // target — so this guest carries none: no ready, exec or cp, and the
  // install is driven over the screen instead.
  agent   = false

  source "iso" { path = "../iso/MS-DOS-6.22-bootable.iso" }
  provision "scripts/install.ws" { }
}
