// Smoke-test the windows-98 template: boot x86/windows-98 on a NAT'd segment and watch the
// console. Build or pull the template first, then from the repo root:
//
//   just example-up windows-98       # bring it up and open the console
//   just example-down windows-98     # tear it down
//
// Hardware (cpus / memory / firmware) is inherited from the template.

import <vmlab.wcl>

lab "windows-98" {

  segment "lan" {
    subnet = "10.99.0.0/24"
    nat    = true
  }

  vm "guest" {
    template = "x86/windows-98"
    nic { segment = "lan" }
  }
}
