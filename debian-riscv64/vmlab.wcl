// Debian 13 (trixie) for riscv64, built from the official `generic` cloud
// qcow2. Runs under TCG on x86 hosts (no KVM) — slow but functional.
// cloud-init picks up the CIDATA seed (NoCloud), creates vmlab/vmlab,
// installs the vmlab guest agent (VMLAB bootstrap ISO) and the provision confirms the agent
// answers before the image is sealed. Build with:
//
//   vmlab template build        (run from this directory)
//
// Image pinned to cloud build 20261001-2618; sha512-verified against
// cloud.debian.org SHA512SUMS, sha256 computed from the verified file.

import <vmlab.wcl>

template "debian-13" {
  arch     = "riscv64"
  version  = "13.20261001"
  registry = "ghcr.io/vmlabdev/vmlab-templates/debian-13"
  profile  = "linux-modern"
  firmware = "ovmf"
  cpus     = 2
  memory   = 2GiB
  disk     = 20GiB

  source "qcow2" {
    url    = "https://cloud.debian.org/images/cloud/trixie/20261001-2618/debian-13-generic-riscv64-20261001-2618.qcow2"
    sha256 = "4591eba27ba71fb7e58cb99b85bd467c29084a6fa35e5fde2fdd757c7529b355"
  }

  media { kind = "iso" from = "./cloudinit/" label = "CIDATA" }
  nic { nat = true }

  provision "scripts/install.ws" { }
}
