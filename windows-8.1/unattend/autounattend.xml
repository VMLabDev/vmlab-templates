<?xml version="1.0" encoding="utf-8"?>
<!--
  Fully unattended Windows 7 Enterprise install for vmlab (legacy profile:
  SeaBIOS/MBR, IDE disk, e1000 NIC — all inbox drivers, no virtio injection).

  After install, the first-logon commands run sysprep /generalize /oobe
  /shutdown with sysprep-unattend.xml (both ride the UNATTEND CD), which powers
  the VM off; the build seals the generalized disk.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">

  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE"
               processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS">
      <SetupUILanguage><UILanguage>en-US</UILanguage></SetupUILanguage>
      <InputLocale>0409:00000409</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Setup"
               processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS">
      <DiskConfiguration>
        <Disk wcm:action="add"
              xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <!-- BIOS/MBR: one active primary partition spanning the disk. -->
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order><Type>Primary</Type><Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Order>1</Order><PartitionID>1</PartitionID>
              <Active>true</Active><Format>NTFS</Format>
              <Label>Windows</Label><Letter>C</Letter>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
      </DiskConfiguration>

      <ImageInstall>
        <OSImage>
          <InstallFrom>
            <MetaData wcm:action="add"
                xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
              <!-- 1 = the single Enterprise image in the VL ISO -->
              <Key>/IMAGE/INDEX</Key>
              <Value>1</Value>
            </MetaData>
          </InstallFrom>
          <InstallTo><DiskID>0</DiskID><PartitionID>1</PartitionID></InstallTo>
        </OSImage>
      </ImageInstall>

      <UserData>
        <AcceptEula>true</AcceptEula>
        <FullName>vmlab</FullName>
        <Organization>vmlab</Organization>
      </UserData>
    </component>
  </settings>

  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS">
      <ComputerName>VMLAB-WIN81</ComputerName>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core"
               processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS">
      <InputLocale>0409:00000409</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS">
{W8}

<OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
        <NetworkLocation>Work</NetworkLocation>
      </OOBE>      <UserAccounts>
        <AdministratorPassword>
          <Value>vmlab123!</Value>
          <PlainText>true</PlainText>
        </AdministratorPassword>"
".<LocalAccounts>
          <LocalAccount wcm:action="add"
              xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
            <Name>vmlab</Name>
            <DisplayName>vmlab</DisplayName>
            <Group>Administrators</Group>
            <Password>
              <Value>vmlab123!</Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>.
      </UserAccounts>

      <AutoLogon>
        <Enabled>true</Enabled>
        <LogonCount>1</LogonCount>
        <Username>Administrator</Username>
        <Password>
          <Value>vmlab123!</Value>
          <PlainText>true</PlainText>
        </Password>
      </AutoLogon>

      <!-- Stage the sysprep answer file off the UNATTEND CD (drive letter
           shifts post-install, so probe a few), then generalize + power off. -->
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add"
            xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
          <Order>1</Order>
          <CommandLine>cmd /c net accounts /maxpwage:unlimited</CommandLine>
          <Description>no password expiry in lab images</Description>
        </SynchronousCommand>
        <!-- virtio-serial, the agent's channel. Installed here rather than
             injected in WinPE: Setup treats an injected driver as
             boot-critical and validates its signature against a SHA-1-era
             trust store, which rejects every current virtio-win driver
             ("Windows Setup could not install one or more boot-critical
             drivers"). Nothing here boots off virtio — the disk is IDE and
             the NIC e1000 — so the running OS installs it instead, and must
             do so before the agent below, which has no channel without it. -->
        <SynchronousCommand wcm:action="add"
            xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
          <Order>2</Order>
          <CommandLine>cmd /c for %d in (D E F G H) do if exist %d:\drivers\vioserial\vioser.inf pnputil -i -a %d:\drivers\vioserial\vioser.inf</CommandLine>
          <Description>virtio-serial driver (the agent's channel)</Description>
        </SynchronousCommand>
        <!-- The vmlab bootstrap ISO installs the guest agent, and it must run
             BEFORE sysprep: the build's verification boot waits for that
             agent's handshake, and a template sealed without it fails.
             install.cmd picks the build from PROCESSOR_ARCHITECTURE. -->
        <SynchronousCommand wcm:action="add"
            xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
          <Order>3</Order>
          <CommandLine>cmd /c for %d in (D E F G H) do if exist %d:\install.cmd call %d:\install.cmd</CommandLine>
          <Description>vmlab guest agent (from the VMLAB bootstrap ISO)</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add"
            xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
          <Order>4</Order>
          <CommandLine>cmd /c for %d in (A B D E F G) do if exist %d:\sysprep-unattend.xml copy /y %d:\sysprep-unattend.xml C:\Windows\Temp\sysprep-unattend.xml</CommandLine>
          <Description>stage the sysprep answer file</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add"
            xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
          <Order>5</Order>
          <CommandLine>cmd /c %WINDIR%\System32\Sysprep\sysprep.exe /generalize /oobe /shutdown /quiet /unattend:C:\Windows\Temp\sysprep-unattend.xml</CommandLine>
          <Description>generalize and power off (build seals on shutdown)</Description>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
