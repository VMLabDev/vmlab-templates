// Windows 8.1 Enterprise, installed from local media. The windows-xp profile
// provides IDE, e1000 and COM1 for the legacy Windows agent. The unattended
// install registers the agent before Sysprep shuts the guest down.

import <vmlab.wcl>

template "windows-8.1" {
  arch    = "x86_64"
  version = "9600.0"
  profile = "windows-xp"
  cpus    = 2
  memory  = 4GiB
  disk    = 40GiB

  login "vmlab" { user = "vmlab" password = "vmlab123!" }

  source "iso" { path = "../iso/en_windows_8_1_enterprise_x64_dvd_2971902.iso" }

  // The installer DVD, answer ISO and agent ISO fill the three free IDE slots.
  media { kind = "iso" from = "./unattend/" label = "UNATTEND" }
  nic { nat = true }

  provision "scripts/install.ws" { }
}
