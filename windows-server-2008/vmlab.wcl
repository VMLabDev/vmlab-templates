// Windows Server 2008 template (PRD §6.1). Legacy guest: SeaBIOS + IDE +
// e1000 (the windows-legacy profile), installed from a local MSDN/VL ISO in
// ../iso/. It installs keyless (no product key needed), so no .env entry.
//
// autounattend.xml installs Windows and then, on first logon, runs the vmlab
// bootstrap ISO's install.cmd and `sysprep /generalize /oobe /shutdown` — in
// that order, because the build's verification boot waits for the agent's
// handshake and an image sealed without one fails. The build waits for the VM
// to power off and seals the generalized disk, so clones come up generalized
// AND agent-carrying: `ready`, `exec` and `cp` all work.

import <vmlab.wcl>

template "windows-server-2008" {
  arch    = "x86_64"
  version = "6001.0"
  profile = "windows-legacy"
  cpus    = 2
  memory  = 4GiB
  disk    = 40GiB

  // No agent: the channel would be virtio-serial, and Vista-era Setup
  // refuses to install the driver for it — "Windows Setup could not
  // install one or more boot-critical drivers", because WinPE from this
  // era validates SHA-1 signatures only and every current virtio-win
  // driver is signed SHA-256. Injecting it later is no better: 32-bit
  // Vista prompts (which an unattended install cannot answer) and 64-bit
  // enforces outright. So these install screen-driven and agent-free,
  // as they did before — `ready`, `exec` and `cp` are unavailable.
  agent   = false

  source "iso" { path = "../iso/en_windows_server_2008_x64_dvd_x14-26714.iso" }

  // An ISO, not a floppy: the answer file now travels with the vioserial
  // driver, and 1.5MB of driver does not fit on 1.44MB of floppy. The
  // guest has four IDE slots — disk, install DVD, this, and the agent
  // bootstrap ISO — which is exactly four.
  media { kind = "iso" from = "./unattend/" label = "UNATTEND" }
  nic { nat = true }

  provision "scripts/install.ws" { }
}
